{
  "name": "usagi-buddy",
  "version": "0.2.0",
  "description": "Usagi Float - Desktop Companion",
  "author": "sonthien22501",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "start": "npm run build && electron dist/main/index.js",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.usagi.float",
    "productName": "Usagi-Float",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "dmg": {
      "writeUpdateInfo": false
    },
    "nsis": {
      "differentialPackage": false
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
